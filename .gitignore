# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Secrets. This repo is public - never commit these.
.env
.env.*
!.env.example

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Generated by build.py. CI rebuilds on every deploy, so committing these only
# creates drift: a stale index.html once shipped an asset hash that no longer
# matched static/, silently defeating the cache-busting it exists to provide.
# Everything under hanyuc.com/data/ is source and stays tracked.
hanyuc.com/*.html
hanyuc.com/static/
hanyuc.com/CNAME
